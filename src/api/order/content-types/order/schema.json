{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "customerName": {
      "type": "string"
    },
    "customerEmail": {
      "type": "email"
    },
    "customerAddress": {
      "type": "string"
    },
    "orderId": {
      "type": "uid"
    },
    "total": {
      "type": "decimal"
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "cancelled"
      ]
    },
    "paymentMethod": {
      "type": "string"
    },
    "products": {
      "type": "json"
    }
  }
}
